<?xml version="1.0" encoding="utf-8"?>
<!--
  [12차시] 화면 이동과 팝업 — 팝업 폼 (자식)
  학습 포인트
   1. 부모가 보낸 파라미터 수신: onload 에서 this.parameters 또는 getOwnerFrame().arguments
   2. 결과 반환: this.close(문자열)  ← 문자열만 가능 → 객체는 JSON.stringify
   3. 더블클릭 선택 패턴 (oncelldblclick)
-->
<FDL version="2.1">
  <Form id="EmpPopup" width="520" height="420" titletext="사원 검색" onload="EmpPopup_onload">
    <Objects>
      <Dataset id="ds_emp"/>
    </Objects>
    <Layouts>
      <Layout height="420" width="520">
        <Edit   id="edt_name" taborder="0" left="20" top="20" width="180" height="28"/>
        <Button id="btn_search" taborder="1" text="검색" left="210" top="20" width="70" height="28" onclick="btn_search_onclick"/>
        <Grid id="grd_emp" taborder="2" left="20" top="60" right="20" bottom="60"
              binddataset="ds_emp" oncelldblclick="grd_emp_oncelldblclick">
          <Formats>
            <Format id="default">
              <Columns><Column size="90"/><Column size="120"/><Column size="100"/><Column size="150"/></Columns>
              <Rows><Row size="28" band="head"/><Row size="26" band="body"/></Rows>
              <Band id="head">
                <Cell text="사번"/><Cell col="1" text="이름"/><Cell col="2" text="부서"/><Cell col="3" text="이메일"/>
              </Band>
              <Band id="body">
                <Cell text="bind:EMP_ID"/><Cell col="1" text="bind:EMP_NM"/>
                <Cell col="2" text="bind:DEPT_CD"/><Cell col="3" text="bind:EMAIL"/>
              </Band>
            </Format>
          </Formats>
        </Grid>
        <Button id="btn_select" taborder="3" text="선택" right="110" bottom="20" width="80" height="30" onclick="btn_select_onclick"/>
        <Button id="btn_close"  taborder="4" text="닫기" right="20"  bottom="20" width="80" height="30" onclick="btn_close_onclick"/>
      </Layout>
    </Layouts>
    <Script type="xscript5.1"><![CDATA[
this.EmpPopup_onload = function(obj:nexacro.Form, e:nexacro.LoadEventInfo)
{
	// 부모가 showModal 의 args 로 넘긴 값 수신
	var ownerFrame = this.getOwnerFrame();
	if (ownerFrame && ownerFrame.arguments && ownerFrame.arguments.searchName) {
		this.edt_name.set_value(ownerFrame.arguments.searchName);
	}
	this.fn_search();   // 열리자마자 1차 조회
};

this.btn_search_onclick = function(obj:nexacro.Button, e:nexacro.ClickEventInfo)
{
	this.fn_search();
};

this.fn_search = function()
{
	var args = "EMP_NM=" + (this.edt_name.value || "");
	this.transaction("svcEmpList", "svc::emp/list.do", "", "ds_emp=ds_out", args, "fn_callback");
};

this.fn_callback = function(svcID, errorCode, errorMsg)
{
	if (errorCode < 0) alert("통신 오류: " + errorMsg);
};

/* 더블클릭 = 선택과 동일 — 실무 팝업의 관례 */
this.grd_emp_oncelldblclick = function(obj:nexacro.Grid, e:nexacro.GridClickEventInfo)
{
	this.fn_select();
};

this.btn_select_onclick = function(obj:nexacro.Button, e:nexacro.ClickEventInfo)
{
	this.fn_select();
};

this.fn_select = function()
{
	var nRow = this.ds_emp.rowposition;
	if (nRow < 0) { alert("선택된 사원이 없습니다."); return; }

	// close() 는 문자열만 전달 가능 → 객체는 JSON 문자열로
	var result = {
		EMP_ID: this.ds_emp.getColumn(nRow, "EMP_ID"),
		EMP_NM: this.ds_emp.getColumn(nRow, "EMP_NM")
	};
	this.close(JSON.stringify(result));
};

this.btn_close_onclick = function(obj:nexacro.Button, e:nexacro.ClickEventInfo)
{
	this.close();   // 값 없이 닫기 = 취소
};
]]></Script>
  </Form>
</FDL>
