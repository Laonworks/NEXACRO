<?xml version="1.0" encoding="utf-8"?>
<!--
  [2차시] 개발 환경 구축 — Hello Nexacro
  학습 포인트
   1. Form / Layout / Component 의 XML 구조 눈으로 확인하기
   2. 컴포넌트 id 로 스크립트에서 접근하기 (this.btn_hello)
   3. 이벤트 핸들러 연결 방식 (onclick="btn_hello_onclick")
  실행: Nexacro Studio 에서 폼 열기 → F6 (QuickView)
-->
<FDL version="2.1">
  <Form id="Hello" width="800" height="600" titletext="Hello Nexacro">
    <Layouts>
      <Layout height="600" width="800">
        <Static id="sta_title" taborder="0" text="나의 첫 번째 넥사크로 화면"
                left="20" top="20" width="300" height="30" font="bold 14pt"/>
        <Button id="btn_hello" taborder="1" text="클릭하세요"
                left="20" top="70" width="120" height="32" onclick="btn_hello_onclick"/>
        <Static id="sta_result" taborder="2" text=""
                left="160" top="70" width="400" height="32"
                style="color:#1f4e79; border:1px solid #cccccc;"/>
      </Layout>
    </Layouts>
    <Script type="xscript5.1"><![CDATA[
/* 버튼 클릭 이벤트
   - obj : 이벤트가 발생한 컴포넌트 자신 (여기서는 btn_hello)
   - e   : 이벤트 정보 객체                                   */
this.btn_hello_onclick = function(obj:nexacro.Button, e:nexacro.ClickEventInfo)
{
	// 1) 가장 기본적인 출력: alert
	alert("Hello Nexacro!");

	// 2) 다른 컴포넌트의 속성 바꾸기: this.<컴포넌트id>.set_<속성>()
	this.sta_result.set_text("버튼이 클릭되었습니다 : " + new Date().toLocaleTimeString());

	// 3) 출력창(Output) 에 로그 남기기 — 디버깅 기본기
	trace("btn_hello_onclick 실행됨");
};
]]></Script>
  </Form>
</FDL>
