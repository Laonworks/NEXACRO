<?xml version="1.0" encoding="utf-8"?>
<FDL version="2.1">
  <Form id="Main" width="1280" height="720" titletext="HR Admin - 메인" onload="Main_onload">
    <Objects>
      <!-- 메뉴 Dataset: 메뉴 추가 = 여기에 행 하나 추가 (코드 수정 불필요!) -->
      <Dataset id="dsMenu">
        <ColumnInfo>
          <Column id="MENU_ID" type="STRING" size="10"/>
          <Column id="MENU_NM" type="STRING" size="50"/>
          <Column id="FORM_URL" type="STRING" size="200"/>
        </ColumnInfo>
        <Rows>
          <Row><Col id="MENU_ID">M001</Col><Col id="MENU_NM">사원 목록 (서버연동)</Col><Col id="FORM_URL">Base::EmpListSvc.xfdl</Col></Row>
          <Row><Col id="MENU_ID">M002</Col><Col id="MENU_NM">사원 등록/수정</Col><Col id="FORM_URL">Base::EmpEdit.xfdl</Col></Row>
          <Row><Col id="MENU_ID">M003</Col><Col id="MENU_NM">부서별 사원 현황</Col><Col id="FORM_URL">Base::DeptEmp.xfdl</Col></Row>
          <Row><Col id="MENU_ID">M004</Col><Col id="MENU_NM">공통 팝업 데모</Col><Col id="FORM_URL">Base::PopupDemo.xfdl</Col></Row>
        </Rows>
      </Dataset>
    </Objects>
    <Layouts>
      <Layout height="720" mobileorientation="none" width="1280">
        <Static id="stTopBg" taborder="0" text="" left="0" top="0" width="1280" height="50" background="#2d6da3"/>
        <Static id="stTopTitle" taborder="1" text="HR Admin — 사원/인사관리 시스템" left="20" top="0" width="400" height="50" color="#ffffff" font="bold 16px/normal &quot;Malgun Gothic&quot;" verticalAlign="middle"/>
        <Static id="stUser" taborder="2" text="" left="1010" top="0" width="150" height="50" color="#ffffff" textAlign="right" verticalAlign="middle"/>
        <Button id="btnLogout" taborder="3" text="로그아웃" left="1175" top="11" width="85" height="28" onclick="btnLogout_onclick"/>
        <Static id="stMenuTitle" taborder="4" text="업무 메뉴" left="0" top="50" width="200" height="36" background="#eef2f6" font="bold 13px/normal &quot;Malgun Gothic&quot;" textAlign="center" verticalAlign="middle"/>
        <Grid id="grdMenu" taborder="5" left="0" top="86" width="200" height="634" binddataset="dsMenu" autofittype="col" oncellclick="grdMenu_oncellclick">
          <Formats>
            <Format id="default">
              <Columns>
                <Column size="200"/>
              </Columns>
              <Rows>
                <Row size="40"/>
              </Rows>
              <Band id="body">
                <Cell text="bind:MENU_NM" verticalAlign="middle" padding="0 0 0 12"/>
              </Band>
            </Format>
          </Formats>
        </Grid>
        <Button id="btnCloseTab" taborder="6" text="현재 탭 닫기" left="1040" top="56" width="105" height="26" onclick="btnCloseTab_onclick"/>
        <Button id="btnCloseAll" taborder="7" text="전체 닫기" left="1155" top="56" width="105" height="26" onclick="btnCloseAll_onclick"/>
        <Tab id="tabWork" taborder="8" left="210" top="88" width="1060" height="622" tabindex="0">
          <Tabpages>
            <Tabpage id="tpHome" text="홈">
              <Static id="stWelcome" taborder="0" text="좌측 메뉴를 클릭하면 업무 화면이 탭으로 열립니다." left="30" top="30" width="500" height="30" color="#666666" verticalAlign="middle"/>
            </Tabpage>
          </Tabpages>
        </Tab>
      </Layout>
    </Layouts>
    <Script type="xscript5.1"><![CDATA[
include "Comm::comm.xjs";   // (8단계에서 추가) 공통 함수 라이브러리

/*******************************************************************************
 * 06. 메인 프레임 (Main.xfdl)  [중급]
 * - 학습 포인트: 메뉴 Dataset 기반 동적 메뉴, 멀티탭 MDI(탭 동적 생성),
 *   탭 중복 오픈 방지, Div의 set_url로 폼 로드, application 전역값 공유
 * - 구조: 상단바(사용자/로그아웃) + 좌측 메뉴 Grid + 우측 Tab(작업 영역)
 * - 메뉴 클릭 → 이미 열린 탭이면 선택만, 없으면 탭 생성 + Div에 폼 로드
 * - (8단계 추가) 앱 차원 공통코드를 여기서 1회 조회 → application Dataset(gdsCode)
 ******************************************************************************/

// 폼 로드: 로그인 화면에서 보관한 사용자 ID 표시 + 공통코드 1회 조회
this.Main_onload = function(obj, e)
{
	var objApp = nexacro.getApplication();
	this.stUser.set_text((objApp.gvUserId == undefined ? "guest" : objApp.gvUserId) + " 님");

	// (8단계에서 추가) 공통코드 전체를 application Dataset으로 수신
	// 전제: app.xadl에 Dataset "gdsCode"가 등록되어 있어야 함 (가이드 참고)
	// 이후 어느 화면에서든 this.gfn_setCombo(콤보, "그룹코드")로 콤보 세팅 가능
	this.transaction("svcCode", "svcData::code_list.xml", "", "gdsCode=dsCode", "", "fnCommCallback");

	// (9단계에서 추가) 다국어 메시지 리소스 수신 + 기본 언어 설정
	// 전제: app.xadl에 Dataset "gdsMsg"가 등록되어 있어야 함
	if (objApp.gvLang == undefined) {
		objApp.gvLang = "KO";
	}
	this.transaction("svcMsg", "svcData::msg_list.xml", "", "gdsMsg=dsMsg", "", "fnCommCallback");
};

// 공통코드 조회 콜백
this.fnCommCallback = function(sSvcId, nErrorCode, sErrorMsg)
{
	if (nErrorCode < 0) {
		this.gfn_alert("공통코드 조회 실패: " + sErrorMsg);
	}
};

// 메뉴 클릭 → 탭 열기
this.grdMenu_oncellclick = function(obj, e)
{
	this.fnOpenMenu(e.row);
};

// ★ 핵심: 메뉴 행 정보로 탭을 열거나(신규) 선택한다(중복 방지)
this.fnOpenMenu = function(nRow)
{
	var sMenuId  = this.dsMenu.getColumn(nRow, "MENU_ID");
	var sMenuNm  = this.dsMenu.getColumn(nRow, "MENU_NM");
	var sFormUrl = this.dsMenu.getColumn(nRow, "FORM_URL");
	var sTpId    = "tp_" + sMenuId;

	// 1) 중복 방지: 이미 열린 탭이면 선택만 하고 종료
	var nFound = this.fnFindTabpage(sTpId);
	if (nFound >= 0) {
		this.tabWork.set_tabindex(nFound);
		return;
	}

	// 2) 탭 페이지 동적 추가
	//    insertTabpage(아이디, 위치, 탭순서, 표시텍스트) — 인자는 F1 레퍼런스로 확인
	var nIndex = this.tabWork.tabpages.length;
	this.tabWork.insertTabpage(sTpId, nIndex, nIndex, sMenuNm);
	var objTabpage = this.tabWork.tabpages[nIndex];

	// 3) 탭 안에 Div를 동적 생성해 가득 채우고, Div에 업무 폼을 로드
	//    init(아이디, left, top, width, height, right, bottom)
	//    — width/height를 null로 두고 right/bottom=0 → 탭 크기에 맞춰 늘어남
	var objDiv = new Div();
	objDiv.init("divWork", 0, 0, null, null, 0, 0);
	objTabpage.addChild("divWork", objDiv);
	objDiv.show();
	objDiv.set_url(sFormUrl);    // ★ 폼 로드 — 초급에서 만든 화면이 그대로 열린다!

	// 4) 새 탭 선택
	this.tabWork.set_tabindex(nIndex);
};

// 탭페이지 id로 인덱스 찾기 (없으면 -1)
this.fnFindTabpage = function(sTpId)
{
	for (var i = 0; i < this.tabWork.tabpages.length; i++) {
		if (this.tabWork.tabpages[i].name == sTpId) {
			return i;
		}
	}
	return -1;
};

// 현재 탭 닫기 (★ 과제 — 아래 힌트를 참고해 직접 구현해 보세요)
this.btnCloseTab_onclick = function(obj, e)
{
	// [과제 힌트]
	// 1) var nIndex = this.tabWork.tabindex;
	// 2) 홈 탭(0번)은 닫지 않도록 보호: if (nIndex <= 0) { 안내 후 return; }
	// 3) this.tabWork.removeTabpage(nIndex);
	// 4) 닫은 뒤 어느 탭을 선택할지 결정 (예: 바로 왼쪽 탭)
	this.alert("과제: removeTabpage()로 현재 탭 닫기를 구현해 보세요.");
};

// 전체 닫기 (★ 과제)
this.btnCloseAll_onclick = function(obj, e)
{
	// [과제 힌트] 홈 탭(0번)만 남기고 "뒤에서부터" 제거해야 인덱스가 꼬이지 않습니다.
	// for (var i = this.tabWork.tabpages.length - 1; i >= 1; i--) { ... }
	this.alert("과제: 홈 탭만 남기고 전체 닫기를 구현해 보세요.");
};

// 로그아웃: 로그인 화면으로 복귀 (프레임의 폼 교체)
this.btnLogout_onclick = function(obj, e)
{
	if (this.confirm("로그아웃 하시겠습니까?")) {
		nexacro.getApplication().gvUserId = undefined;
		this.getOwnerFrame().set_formurl("Base::Login.xfdl");
	}
};
]]></Script>
  </Form>
</FDL>
