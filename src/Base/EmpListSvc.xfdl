<?xml version="1.0" encoding="utf-8"?>
<FDL version="2.1">
  <Form id="EmpListSvc" width="1280" height="720" titletext="HR Admin - 사원 목록 (서버 연동)" onload="EmpListSvc_onload">
    <Objects>
      <!-- ★ 5단계의 핵심 변화: Dataset에 Rows(초기 데이터)가 없습니다.
           모든 데이터는 transaction()으로 서버(정적 XML)에서 받아옵니다. -->
      <Dataset id="dsEmp" onrowposchanged="dsEmp_onrowposchanged">
        <ColumnInfo>
          <Column id="EMP_ID" type="STRING" size="10"/>
          <Column id="EMP_NM" type="STRING" size="50"/>
          <Column id="DEPT_CD" type="STRING" size="10"/>
          <Column id="POSITION_CD" type="STRING" size="10"/>
          <Column id="GENDER_CD" type="STRING" size="1"/>
          <Column id="HIRE_DT" type="STRING" size="8"/>
          <Column id="EMAIL" type="STRING" size="100"/>
          <Column id="PHONE" type="STRING" size="20"/>
          <Column id="SALARY" type="INT" size="10"/>
          <Column id="USE_YN" type="STRING" size="1"/>
        </ColumnInfo>
      </Dataset>
      <Dataset id="dsDept">
        <ColumnInfo>
          <Column id="DEPT_CD" type="STRING" size="10"/>
          <Column id="DEPT_NM" type="STRING" size="50"/>
          <Column id="USE_YN" type="STRING" size="1"/>
        </ColumnInfo>
      </Dataset>
      <Dataset id="dsCode">
        <ColumnInfo>
          <Column id="GROUP_CD" type="STRING" size="10"/>
          <Column id="CODE" type="STRING" size="10"/>
          <Column id="CODE_NM" type="STRING" size="50"/>
          <Column id="SORT_NO" type="INT" size="5"/>
        </ColumnInfo>
      </Dataset>
      <!-- dsCode에서 그룹별로 분리해 담을 코드 Dataset (Grid combotext용) -->
      <Dataset id="dsPosition">
        <ColumnInfo>
          <Column id="CODE" type="STRING" size="10"/>
          <Column id="CODE_NM" type="STRING" size="50"/>
        </ColumnInfo>
      </Dataset>
      <Dataset id="dsUseYn">
        <ColumnInfo>
          <Column id="CODE" type="STRING" size="10"/>
          <Column id="CODE_NM" type="STRING" size="50"/>
        </ColumnInfo>
      </Dataset>
    </Objects>
    <Layouts>
      <Layout height="720" mobileorientation="none" width="1280">
        <Static id="stFormTitle" taborder="0" text="사원 목록 (서버 연동)" left="20" top="15" width="300" height="30" font="bold 18px/normal &quot;Malgun Gothic&quot;" verticalAlign="middle"/>
        <Button id="btnExcel" taborder="9" text="엑셀 복사" left="550" top="15" width="100" height="30" onclick="btnExcel_onclick"/>
        <Button id="btnLang" taborder="10" text="English" left="660" top="15" width="100" height="30" onclick="btnLang_onclick"/>
        <Static id="stSearchNm" taborder="1" text="사원명" left="780" top="18" width="60" height="26" verticalAlign="middle" textAlign="right"/>
        <Edit id="edtSearchNm" taborder="2" left="850" top="15" width="180" height="30"/>
        <Button id="btnSearch" taborder="3" text="조회" left="1040" top="15" width="80" height="30" onclick="btnSearch_onclick"/>
        <Button id="btnReload" taborder="4" text="전체 재조회" left="1130" top="15" width="130" height="30" onclick="btnReload_onclick"/>
        <Grid id="grdEmp" taborder="5" left="20" top="55" width="1240" height="430" binddataset="dsEmp" autofittype="col">
          <Formats>
            <Format id="default">
              <Columns>
                <Column size="80"/>
                <Column size="90"/>
                <Column size="110"/>
                <Column size="80"/>
                <Column size="100"/>
                <Column size="200"/>
                <Column size="130"/>
                <Column size="80"/>
                <Column size="70"/>
              </Columns>
              <Rows>
                <Row size="32" band="head"/>
                <Row size="30"/>
              </Rows>
              <Band id="head">
                <Cell text="사번"/>
                <Cell col="1" text="사원명"/>
                <Cell col="2" text="부서"/>
                <Cell col="3" text="직급"/>
                <Cell col="4" text="입사일"/>
                <Cell col="5" text="이메일"/>
                <Cell col="6" text="전화번호"/>
                <Cell col="7" text="연봉"/>
                <Cell col="8" text="재직"/>
              </Band>
              <Band id="body">
                <Cell text="bind:EMP_ID" textAlign="center"/>
                <Cell col="1" text="bind:EMP_NM" textAlign="center"/>
                <Cell col="2" text="bind:DEPT_CD" displaytype="combotext" combodataset="dsDept" combocodecol="DEPT_CD" combodatacol="DEPT_NM" textAlign="center"/>
                <Cell col="3" text="bind:POSITION_CD" displaytype="combotext" combodataset="dsPosition" combocodecol="CODE" combodatacol="CODE_NM" textAlign="center"/>
                <Cell col="4" text="bind:HIRE_DT" textAlign="center"/>
                <Cell col="5" text="bind:EMAIL"/>
                <Cell col="6" text="bind:PHONE" textAlign="center"/>
                <Cell col="7" text="bind:SALARY" textAlign="right"/>
                <Cell col="8" text="bind:USE_YN" displaytype="combotext" combodataset="dsUseYn" combocodecol="CODE" combodatacol="CODE_NM" textAlign="center"/>
              </Band>
            </Format>
          </Formats>
        </Grid>
        <Static id="stTotal" taborder="6" text="총 0명" left="20" top="490" width="200" height="24" color="#555555" verticalAlign="middle"/>
        <Static id="stLogTitle" taborder="7" text="통신 로그" left="20" top="520" width="200" height="24" font="bold 13px/normal &quot;Malgun Gothic&quot;" verticalAlign="middle"/>
        <TextArea id="txaLog" taborder="8" left="20" top="548" width="1240" height="150" readonly="true" wordwrap="char"/>
      </Layout>
    </Layouts>
    <Script type="xscript5.1"><![CDATA[
include "Comm::comm.xjs";   // (9단계에서 추가) 공통 함수 라이브러리

/*******************************************************************************
 * 05. 사원 목록 - 서버 연동 (EmpListSvc.xfdl)  [중급 시작]
 * (9단계에서 추가된 기능)
 *  - 엑셀 복사: Grid 데이터를 TSV로 만들어 클립보드에 복사 → 엑셀에 붙여넣기
 *  - 한/영 전환: 다국어 리소스(gdsMsg) + gfn_msg()로 화면 문구 일괄 교체
 * - 학습 포인트: transaction() 6개 인자, 비동기 통신과 콜백,
 *   서비스(prefixid) 등록, ErrorCode 처리, 공통코드 Dataset 분리(copyData)
 * - 2단계 EmpList와 비교: Dataset에 <Rows>가 없고, 데이터는 전부
 *   data/*.xml(정적 XML 서비스)에서 transaction으로 받아옵니다.
 *
 * [사전 준비 - 서비스 등록]
 * 1) data/ 폴더(emp_list.xml 등 3개 파일)를 Nexacro 프로젝트 폴더에 복사
 * 2) typedefinition > Services에 등록:
 *    prefixid = "svcData",  url = "data/"   (상대 경로)
 * 3) 이후 URL은 "svcData::emp_list.xml" 형태로 사용
 ******************************************************************************/

// 폼 로드: 공통코드 → 부서 → 사원 순서로 조회 시작 (모두 비동기!)
this.EmpListSvc_onload = function(obj, e)
{
	this.fnLog("화면 로드 — 서버 조회를 시작합니다.");
	this.transaction("svcCode", "svcData::code_list.xml", "", "dsCode=dsCode", "", "fnCallback");
	this.transaction("svcDept", "svcData::dept_list.xml", "", "dsDept=dsDept", "", "fnCallback");
	this.transaction("svcEmp",  "svcData::emp_list.xml",  "", "dsEmp=dsEmp",  "", "fnCallback");
	this.fnLog("transaction 3건 요청 완료 — 응답은 콜백으로 도착합니다. (비동기)");
	this.fnApplyLang();   // (9단계) 현재 언어로 화면 문구 적용
};

/*
 * ★ transaction() 6개 인자
 *   1. strSvcID   : 통신 구분 ID (콜백에서 어떤 요청인지 식별)
 *   2. strURL     : "서비스prefixid::파일(또는 서비스경로)"
 *   3. strInDs    : 보낼 Dataset  "서버이름=화면이름" (조회는 보통 "")
 *   4. strOutDs   : 받을 Dataset  "화면이름=서버이름"
 *   5. strArgs    : 전달 인자     "키=값 키2=값2"
 *   6. strCallback: 응답 도착 시 실행할 함수명
 */

// 공통 콜백: 모든 transaction 응답이 여기로 모인다 (sSvcId로 분기)
this.fnCallback = function(sSvcId, nErrorCode, sErrorMsg)
{
	// 1) 공통 오류 처리: ErrorCode가 음수면 실패
	if (nErrorCode < 0) {
		this.fnLog("[" + sSvcId + "] 실패! ErrorCode=" + nErrorCode + ", " + sErrorMsg);
		this.alert("통신 오류가 발생했습니다.\n" + sErrorMsg);
		return;
	}

	// 2) 서비스 ID별 후처리
	switch (sSvcId) {
		case "svcCode":
			// 공통코드를 그룹별 Dataset으로 분리 (8단계에서 공통모듈로 발전)
			this.fnSplitCode("POSITION", this.dsPosition);
			this.fnSplitCode("USE_YN", this.dsUseYn);
			this.fnLog("[svcCode] 성공 — 공통코드 " + this.dsCode.getRowCount() + "건 수신, 그룹 분리 완료");
			break;
		case "svcDept":
			this.fnLog("[svcDept] 성공 — 부서 " + this.dsDept.getRowCount() + "건 수신");
			break;
		case "svcEmp":
			this.fnDisplayCount();
			this.fnLog("[svcEmp] 성공 — 사원 " + this.dsEmp.getRowCount() + "건 수신");
			break;
	}
};

// dsCode에서 특정 그룹만 골라 대상 Dataset에 복사 (filter + copyData 패턴)
this.fnSplitCode = function(sGroupCd, objTargetDs)
{
	this.dsCode.filter("GROUP_CD == '" + sGroupCd + "'");
	objTargetDs.copyData(this.dsCode, true);   // true = filter된 행만 복사
	this.dsCode.filter("");
	// 복사된 컬럼명은 dsCode와 동일(GROUP_CD, CODE, CODE_NM...) — CODE/CODE_NM만 사용
};

// 조회 버튼: 사원명 조건 조회 (★ 과제 — 아래 힌트 참고)
this.btnSearch_onclick = function(obj, e)
{
	// [과제 힌트] 인자(5번째 매개변수)로 조회 조건을 전달해 보세요.
	// var sArgs = "sEmpNm=" + nexacro.wrapQuote(this.edtSearchNm.value);
	// this.transaction("svcEmpSearch", "svcData::emp_list.xml", "", "dsEmp=dsEmp", sArgs, "fnCallback");
	//
	// 실행해 보면? — 정적 XML 파일은 인자를 "무시"하고 항상 전체를 돌려줍니다.
	// 1) 우선 응답 후 클라이언트에서 filter로 거르도록 구현해 보세요.
	//    (svcEmpSearch 케이스를 콜백에 추가)
	// 2) 토론: 실제 서버(WAS)라면 sEmpNm을 받아 SQL WHERE로 거른 결과만 내려줍니다.
	//    "어디서 거르는 게 맞는가?" — 데이터 1만 건 가정으로 토론해 보세요.
	this.alert("과제: 인자 전달 + 클라이언트 filter로 조건 조회를 구현해 보세요.");
};

// 전체 재조회: 같은 조회를 다시 요청 (받을 Dataset은 자동으로 초기화 후 채워짐)
this.btnReload_onclick = function(obj, e)
{
	this.edtSearchNm.set_value("");
	this.dsEmp.filter("");
	this.transaction("svcEmp", "svcData::emp_list.xml", "", "dsEmp=dsEmp", "", "fnCallback");
	this.fnLog("[svcEmp] 재조회 요청");
};

this.dsEmp_onrowposchanged = function(obj, e)
{
	// 이번 화면은 목록 전용 — 필요 시 2단계처럼 상세 연동 가능
};

this.fnDisplayCount = function()
{
	// (9단계 수정) 다국어 템플릿 사용 — "총 {0}명" / "Total: {0}"
	this.stTotal.set_text(this.gfn_msg("MSG_TOTAL").replace("{0}", this.dsEmp.getRowCount()));
};

/*******************************************************************************
 * (9단계 추가) 엑셀 복사 — 서버 모듈 없이 동작하는 클립보드 방식
 * 실무 표준은 ExcelExportObject + 서버 export 모듈(XENI)입니다. (가이드 참고)
 ******************************************************************************/
this.btnExcel_onclick = function(obj, e)
{
	this.fnExportToClipboard();
};

this.fnExportToClipboard = function()
{
	var sTab = "\t";
	var sNl  = "\n";

	// 1) 헤더 행 (현재 언어 기준)
	var arrHdr = ["HDR_EMPID", "HDR_EMPNM", "HDR_DEPT", "HDR_POSITION",
	              "HDR_HIREDT", "HDR_EMAIL", "HDR_PHONE", "HDR_SALARY", "HDR_USEYN"];
	var arrLine = [];
	for (var h = 0; h < arrHdr.length; h++) {
		arrLine.push(this.gfn_msg(arrHdr[h]));
	}
	var sText = arrLine.join(sTab) + sNl;

	// 2) 데이터 행 — filter 상태면 보이는 행만 (조회 결과 = 내보내기 결과)
	for (var i = 0; i < this.dsEmp.getRowCount(); i++) {
		arrLine = [];
		arrLine.push(this.dsEmp.getColumn(i, "EMP_ID"));
		arrLine.push(this.dsEmp.getColumn(i, "EMP_NM"));
		arrLine.push(this.fnCodeName(this.dsDept, "DEPT_CD", "DEPT_NM", this.dsEmp.getColumn(i, "DEPT_CD")));
		arrLine.push(this.fnCodeName(this.dsPosition, "CODE", "CODE_NM", this.dsEmp.getColumn(i, "POSITION_CD")));
		arrLine.push(this.dsEmp.getColumn(i, "HIRE_DT"));
		arrLine.push(this.dsEmp.getColumn(i, "EMAIL"));
		arrLine.push(this.dsEmp.getColumn(i, "PHONE"));
		arrLine.push(this.dsEmp.getColumn(i, "SALARY"));
		arrLine.push(this.fnCodeName(this.dsUseYn, "CODE", "CODE_NM", this.dsEmp.getColumn(i, "USE_YN")));
		sText += arrLine.join(sTab) + sNl;
	}

	// 3) 클립보드에 복사 — TSV는 엑셀에 붙여넣으면 셀 단위로 들어간다
	system.setClipboard("CF_TEXT", sText);
	this.fnLog("엑셀 복사 — " + this.dsEmp.getRowCount() + "건을 클립보드로 복사");
	this.gfn_alert(this.gfn_msg("MSG_COPIED"));
};

// 코드 → 이름 변환 (Grid combotext가 하던 일을 스크립트에서)
this.fnCodeName = function(objDs, sCodeCol, sNameCol, sCode)
{
	var nRow = objDs.findRow(sCodeCol, sCode);
	return (nRow < 0 ? sCode : objDs.getColumn(nRow, sNameCol));
};

/*******************************************************************************
 * (9단계 추가) 한/영 전환 — 다국어 리소스(gdsMsg) 기반
 ******************************************************************************/
this.btnLang_onclick = function(obj, e)
{
	var objApp = nexacro.getApplication();
	objApp.gvLang = (objApp.gvLang == "EN" ? "KO" : "EN");   // 언어 토글 (전역)
	this.fnApplyLang();
	this.fnLog("언어 전환 → " + objApp.gvLang);
};

// 현재 언어(gvLang)로 화면의 모든 문구를 다시 그린다
this.fnApplyLang = function()
{
	this.stFormTitle.set_text(this.gfn_msg("TITLE_EMPLIST"));
	this.stSearchNm.set_text(this.gfn_msg("LBL_EMPNM"));
	this.btnSearch.set_text(this.gfn_msg("BTN_SEARCH"));
	this.btnReload.set_text(this.gfn_msg("BTN_RELOAD"));
	this.btnExcel.set_text(this.gfn_msg("BTN_EXCEL"));
	this.btnLang.set_text(this.gfn_msg("BTN_LANG"));

	// Grid 헤더는 setCellProperty로 셀 단위 교체
	var arrHdr = ["HDR_EMPID", "HDR_EMPNM", "HDR_DEPT", "HDR_POSITION",
	              "HDR_HIREDT", "HDR_EMAIL", "HDR_PHONE", "HDR_SALARY", "HDR_USEYN"];
	for (var i = 0; i < arrHdr.length; i++) {
		this.grdEmp.setCellProperty("head", i, "text", this.gfn_msg(arrHdr[i]));
	}

	this.fnDisplayCount();   // "총 {0}명" / "Total: {0}"도 갱신
};

// 통신 로그 출력 (비동기 흐름을 눈으로 확인하는 학습용 장치)
this.fnLog = function(sMsg)
{
	var sNow = new Date().toTimeString().substr(0, 8);
	this.txaLog.set_value(this.txaLog.value + "[" + sNow + "] " + sMsg + "\n");
};
]]></Script>
  </Form>
</FDL>
