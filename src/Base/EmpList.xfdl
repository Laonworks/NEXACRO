<?xml version="1.0" encoding="utf-8"?>
<FDL version="2.1">
  <Form id="EmpList" width="1280" height="720" titletext="HR Admin - 사원 목록" onload="EmpList_onload">
    <Objects>
      <Dataset id="dsEmp" onrowposchanged="dsEmp_onrowposchanged">
