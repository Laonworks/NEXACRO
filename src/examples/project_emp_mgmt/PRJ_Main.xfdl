<?xml version="1.0" encoding="utf-8"?>
<!--
  [13차시] 프로젝트 골격 — 메인 화면 (메뉴 + 작업영역)
  - 좌측 메뉴 클릭 → div_work 에 화면 로드 (3차시 구조의 실전 적용)
  - 실제 현장에서는 .xadl 의 FrameSet 으로 구성하지만,
    교육용으로는 Form + Div 구조가 디버깅과 이해에 유리하다.
-->
<FDL version="2.1">
  <Form id="PRJ_Main" width="1280" height="800" titletext="사원 관리 시스템" onload="PRJ_Main_onload">
    <Layouts>
      <Layout height="800" width="1280">
        <Static id="sta_top" taborder="0" text="  사원 관리 시스템 (Nexacro 실습 프로젝트)"
                left="0" top="0" right="0" height="56"
                style="background:#1f4e79; color:#ffffff; font:bold 15pt;"/>
        <Div id="div_menu" taborder="1" left="0" top="56" width="210" bottom="0"
             style="background:#eff5f8; border-right:1px solid #cccccc;">
          <Layouts>
            <Layout>
              <Button id="btn_emp"  taborder="0" text="사원 관리" left="15" top="20" width="180" height="40" onclick="div_menu_btn_onclick"/>
              <Button id="btn_dept" taborder="1" text="부서 관리" left="15" top="66" width="180" height="40" onclick="div_menu_btn_onclick"/>
            </Layout>
          </Layouts>
        </Div>
        <Div id="div_work" taborder="2" left="210" top="56" right="0" bottom="0"/>
      </Layout>
    </Layouts>
    <Script type="xscript5.1"><![CDATA[
include "Lib::comm.xjs";

this.PRJ_Main_onload = function(obj:nexacro.Form, e:nexacro.LoadEventInfo)
{
	// 첫 화면: 사원 목록
	this.fn_moveMenu("Base::EMP_M001_List.xfdl");
};

this.div_menu_btn_onclick = function(obj:nexacro.Button, e:nexacro.ClickEventInfo)
{
	if (obj.id == "btn_emp") {
		this.fn_moveMenu("Base::EMP_M001_List.xfdl");
	}
	else {
		this.gfn_alert("부서 관리는 심화 과제입니다. 직접 만들어 보세요!");
	}
};

/* 작업영역 화면 전환 — 모든 화면 이동은 이 함수를 거친다 */
this.fn_moveMenu = function(formUrl)
{
	this.div_work.set_url(formUrl);
};

/* ── 목록 → 상세 이동 (자식 화면이 호출하는 공개 함수) ──
   empId: null 이면 신규 등록 모드                              */
this.fn_moveDetail = function(empId)
{
	this.div_work.set_url("Base::EMP_M002_Detail.xfdl");

	// set_url 은 비동기 — onload 이후 파라미터를 전달해야 한다.
	// 자식 폼의 onload 에서 parent.gv_empId 를 읽는 방식으로 단순화.
	this.gv_empId = empId;
};

/* 상세 → 목록 복귀 */
this.fn_moveList = function()
{
	this.gv_empId = null;
	this.div_work.set_url("Base::EMP_M001_List.xfdl");
};
]]></Script>
  </Form>
</FDL>
