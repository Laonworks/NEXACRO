<?xml version="1.0" encoding="utf-8"?>
<!--
  [14차시] 사원 목록 화면 (EMP_M001)
  - 검색조건(부서/이름) → 조회 → Grid 출력 → 더블클릭 시 상세 이동
  - 6차시 검색바 + 10차시 transaction + 8차시 Grid 의 종합
  - 화면ID 명명 규칙: <업무코드>_<화면구분><번호>_<용도> — SI 현장 관례 체험
-->
<FDL version="2.1">
  <Form id="EMP_M001_List" width="1070" height="744" titletext="사원 목록" onload="EMP_M001_List_onload">
    <Objects>
      <Dataset id="ds_emp"/>
      <Dataset id="ds_dept"/>
    </Objects>
    <Layouts>
      <Layout height="744" width="1070">
        <Static id="sta_title" taborder="0" text="사원 목록" left="20" top="15" width="200" height="30" font="bold 13pt"/>

        <Static id="sta_bg" taborder="1" text="" left="20" top="55" right="20" height="60"
                style="background:#eff5f8; border:1px solid #cccccc;"/>
        <Static id="sta_dept" taborder="2" text="부서" left="40" top="71" width="50" height="28"/>
        <Combo  id="cbo_dept" taborder="3" left="90" top="71" width="140" height="28"
                innerdataset="ds_dept" codecolumn="CODE" datacolumn="NAME"/>
        <Static id="sta_name" taborder="4" text="이름" left="250" top="71" width="50" height="28"/>
        <Edit   id="edt_name" taborder="5" left="300" top="71" width="140" height="28" onkeyup="edt_name_onkeyup"/>
        <Button id="btn_search" taborder="6" text="조회" top="71" right="130" width="80" height="28" onclick="btn_search_onclick"/>
        <Button id="btn_new" taborder="7" text="신규 등록" top="71" right="40" width="80" height="28" onclick="btn_new_onclick"/>

        <Grid id="grd_emp" taborder="8" left="20" top="135" right="20" bottom="60"
              binddataset="ds_emp" oncelldblclick="grd_emp_oncelldblclick" onheadclick="grd_emp_onheadclick">
          <Formats>
            <Format id="default">
              <Columns>
                <Column size="100"/><Column size="130"/><Column size="130"/>
                <Column size="120"/><Column size="130"/><Column size="220"/>
              </Columns>
              <Rows><Row size="30" band="head"/><Row size="28" band="body"/></Rows>
              <Band id="head">
                <Cell text="사번"/><Cell col="1" text="이름"/><Cell col="2" text="부서"/>
                <Cell col="3" text="연봉(만원)"/><Cell col="4" text="입사일"/><Cell col="5" text="이메일"/>
              </Band>
              <Band id="body">
                <Cell text="bind:EMP_ID" textAlign="center"/>
                <Cell col="1" text="bind:EMP_NM"/>
                <Cell col="2" text="bind:DEPT_CD" displaytype="combocontrol"
                      combodataset="ds_dept" combocodecol="CODE" combodatacol="NAME"/>
                <Cell col="3" text="bind:SALARY" displaytype="numbercontrol" mask="#,##0" textAlign="right"/>
                <Cell col="4" text="bind:HIRE_DT" displaytype="datecontrol" mask="yyyy-MM-dd" textAlign="center"/>
                <Cell col="5" text="bind:EMAIL"/>
              </Band>
            </Format>
          </Formats>
        </Grid>
        <Static id="sta_count" taborder="9" text="총 0건" left="20" bottom="20" width="300" height="28"/>
        <Static id="sta_hint" taborder="10" text="행을 더블클릭하면 상세 화면으로 이동합니다"
                bottom="20" right="20" width="320" height="28" style="color:#888888;" textAlign="right"/>
      </Layout>
    </Layouts>
    <Script type="xscript5.1"><![CDATA[
include "Lib::comm.xjs";

this.EMP_M001_List_onload = function(obj:nexacro.Form, e:nexacro.LoadEventInfo)
{
	this.gfn_transaction("svcDeptList", "svc::dept/list.do", "", "ds_dept=ds_dept", "", "fn_callback");
};

this.btn_search_onclick = function(obj:nexacro.Button, e:nexacro.ClickEventInfo)
{
	this.fn_search();
};

/* Enter 키로도 조회 — 사용성 디테일 */
this.edt_name_onkeyup = function(obj:nexacro.Edit, e:nexacro.KeyEventInfo)
{
	if (e.keycode == 13) this.fn_search();
};

this.fn_search = function()
{
	var args = "DEPT_CD=" + this.gfn_nvl(this.cbo_dept.value)
	         + " EMP_NM=" + this.gfn_nvl(this.edt_name.value);
	this.gfn_transaction("svcEmpList", "svc::emp/list.do", "", "ds_emp=ds_out", args, "fn_callback");
};

this.fn_callback = function(svcID, errorCode, errorMsg)
{
	if (!this.gfn_callbackCheck(svcID, errorCode, errorMsg)) return;

	if (svcID == "svcDeptList") {
		var nRow = this.ds_dept.insertRow(0);
		this.ds_dept.setColumn(nRow, "CODE", "");
		this.ds_dept.setColumn(nRow, "NAME", "전체");
		this.cbo_dept.set_index(0);
		this.fn_search();          // 부서 로드 후 최초 조회
	}
	else if (svcID == "svcEmpList") {
		this.sta_count.set_text("총 " + this.ds_emp.getRowCount() + "건");
	}
};

/* 더블클릭 → 상세 이동. 부모(PRJ_Main)의 공개 함수 호출 */
this.grd_emp_oncelldblclick = function(obj:nexacro.Grid, e:nexacro.GridClickEventInfo)
{
	var empId = this.ds_emp.getColumn(e.row, "EMP_ID");
	this.parent.parent.fn_moveDetail(empId);   // Div(div_work) → Form(PRJ_Main)
};

this.btn_new_onclick = function(obj:nexacro.Button, e:nexacro.ClickEventInfo)
{
	this.parent.parent.fn_moveDetail(null);    // null = 신규 등록 모드
};

/* 헤더 클릭 정렬 (9차시 패턴 재사용) */
this.grd_emp_onheadclick = function(obj:nexacro.Grid, e:nexacro.GridClickEventInfo)
{
	var colId = obj.getCellProperty("body", e.cell, "text");
	if (colId == null || String(colId).indexOf("bind:") < 0) return;
	colId = String(colId).replace("bind:", "");

	var curKey = this.ds_emp.keystring || "";
	this.ds_emp.set_keystring(curKey == "S:+" + colId ? "S:-" + colId : "S:+" + colId);
};
]]></Script>
  </Form>
</FDL>
