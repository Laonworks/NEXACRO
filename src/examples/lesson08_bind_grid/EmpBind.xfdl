<?xml version="1.0" encoding="utf-8"?>
<!--
  [8차시] 데이터 바인딩과 Grid
  학습 포인트
   1. Grid 의 binddataset : Dataset 을 연결하면 행 데이터가 자동 표시
   2. <Bind> 의 BindItem : Dataset 의 "현재행" 컬럼 ↔ 입력 컴포넌트 양방향 연동
      → Grid 에서 행을 클릭하면(rowposition 이동) 아래 상세폼이 자동으로 바뀐다!
      → 상세폼에서 값을 고치면 Dataset(=Grid)도 즉시 바뀐다!
   3. Grid Cell 의 text="bind:컬럼명" / displaytype / expr 표현식
-->
<FDL version="2.1">
  <Form id="EmpBind" width="900" height="650" titletext="바인딩과 Grid">
    <Objects>
      <Dataset id="ds_emp">
        <ColumnInfo>
          <Column id="EMP_ID"  type="STRING" size="10"/>
          <Column id="EMP_NM"  type="STRING" size="30"/>
          <Column id="DEPT_CD" type="STRING" size="10"/>
          <Column id="SALARY"  type="INT"/>
          <Column id="HIRE_DT" type="STRING" size="8"/>
        </ColumnInfo>
        <Rows>
          <Row><Col id="EMP_ID">E001</Col><Col id="EMP_NM">김철수</Col><Col id="DEPT_CD">D01</Col><Col id="SALARY">3500</Col><Col id="HIRE_DT">20200301</Col></Row>
          <Row><Col id="EMP_ID">E002</Col><Col id="EMP_NM">이영희</Col><Col id="DEPT_CD">D02</Col><Col id="SALARY">4200</Col><Col id="HIRE_DT">20180715</Col></Row>
          <Row><Col id="EMP_ID">E003</Col><Col id="EMP_NM">박민준</Col><Col id="DEPT_CD">D01</Col><Col id="SALARY">2900</Col><Col id="HIRE_DT">20220502</Col></Row>
          <Row><Col id="EMP_ID">E004</Col><Col id="EMP_NM">최수진</Col><Col id="DEPT_CD">D03</Col><Col id="SALARY">3800</Col><Col id="HIRE_DT">20190910</Col></Row>
        </Rows>
      </Dataset>
      <Dataset id="ds_dept">
        <ColumnInfo>
          <Column id="CODE" type="STRING" size="10"/>
          <Column id="NAME" type="STRING" size="30"/>
        </ColumnInfo>
        <Rows>
          <Row><Col id="CODE">D01</Col><Col id="NAME">개발팀</Col></Row>
          <Row><Col id="CODE">D02</Col><Col id="NAME">영업팀</Col></Row>
          <Row><Col id="CODE">D03</Col><Col id="NAME">인사팀</Col></Row>
        </Rows>
      </Dataset>
    </Objects>
    <Layouts>
      <Layout height="650" width="900">
        <Static id="sta_grid" taborder="0" text="사원 목록 (행을 클릭해 보세요)" left="20" top="15" width="300" height="25" font="bold 10pt"/>
        <Grid id="grd_emp" taborder="1" left="20" top="45" right="20" height="280" binddataset="ds_emp">
          <Formats>
            <Format id="default">
              <Columns>
                <Column size="90"/>
                <Column size="120"/>
                <Column size="120"/>
                <Column size="110"/>
                <Column size="130"/>
              </Columns>
              <Rows>
                <Row size="28" band="head"/>
                <Row size="26" band="body"/>
              </Rows>
              <Band id="head">
                <Cell text="사번"/>
                <Cell col="1" text="이름"/>
                <Cell col="2" text="부서"/>
                <Cell col="3" text="연봉(만원)"/>
                <Cell col="4" text="입사일"/>
              </Band>
              <Band id="body">
                <Cell text="bind:EMP_ID"/>
                <Cell col="1" text="bind:EMP_NM"/>
                <!-- displaytype=combo : 코드(D01)를 명칭(개발팀)으로 표시 -->
                <Cell col="2" text="bind:DEPT_CD" displaytype="combocontrol"
                      combodataset="ds_dept" combocodecol="CODE" combodatacol="NAME"/>
                <!-- 숫자 천단위 콤마 표시 -->
                <Cell col="3" text="bind:SALARY" displaytype="numbercontrol" mask="#,##0" textAlign="right"/>
                <!-- 날짜 형식 변환: 20200301 → 2020-03-01 -->
                <Cell col="4" text="bind:HIRE_DT" displaytype="datecontrol" mask="yyyy-MM-dd" calendardisplaynulltype="none"/>
              </Band>
            </Format>
          </Formats>
        </Grid>

        <!-- 상세 영역: 모두 BindItem 으로 ds_emp 현재행과 연결됨 (스크립트 0줄!) -->
        <Static id="sta_detail" taborder="2" text="상세 정보 (Grid 와 양방향 연동)" left="20" top="345" width="300" height="25" font="bold 10pt"/>
        <Static id="sta_id" taborder="3" text="사번" left="20" top="380" width="80" height="28"/>
        <Edit id="edt_id" taborder="4" left="110" top="380" width="160" height="28" readonly="true"/>
        <Static id="sta_nm" taborder="5" text="이름" left="20" top="418" width="80" height="28"/>
        <Edit id="edt_nm" taborder="6" left="110" top="418" width="160" height="28"/>
        <Static id="sta_dept" taborder="7" text="부서" left="20" top="456" width="80" height="28"/>
        <Combo id="cbo_dept" taborder="8" left="110" top="456" width="160" height="28"
               innerdataset="ds_dept" codecolumn="CODE" datacolumn="NAME"/>
        <Static id="sta_sal" taborder="9" text="연봉" left="20" top="494" width="80" height="28"/>
        <MaskEdit id="msk_sal" taborder="10" left="110" top="494" width="160" height="28" type="number" mask="#,##0"/>
      </Layout>
    </Layouts>
    <!-- 바인딩 정의: compid.propid ↔ datasetid.columnid -->
    <Bind>
      <BindItem id="item0" compid="edt_id"   propid="value" datasetid="ds_emp" columnid="EMP_ID"/>
      <BindItem id="item1" compid="edt_nm"   propid="value" datasetid="ds_emp" columnid="EMP_NM"/>
      <BindItem id="item2" compid="cbo_dept" propid="value" datasetid="ds_emp" columnid="DEPT_CD"/>
      <BindItem id="item3" compid="msk_sal"  propid="value" datasetid="ds_emp" columnid="SALARY"/>
    </Bind>
    <Script type="xscript5.1"><![CDATA[
/* 이 폼의 핵심 메시지:
   "Grid 행 클릭 → rowposition 이동 → BindItem 이 상세폼 자동 갱신"
   "상세폼 수정 → Dataset 변경 → Grid 자동 갱신"
   바인딩 덕분에 이 동작에 스크립트가 한 줄도 필요 없다.            */
]]></Script>
  </Form>
</FDL>
