<?xml version="1.0" encoding="utf-8"?>
<!--
  [4차시] 스크립트 기초 — 입력값 검증(Validation)
  학습 포인트
   1. onload(Form onload) : 폼 초기화 코드의 위치
   2. 함수 분리: 이벤트 핸들러 vs 일반 함수 (fn_ 접두어 관례)
   3. 컴포넌트 값 읽기 (edt.value) / 포커스 이동 (setFocus)
   4. JavaScript 기본 문법이 그대로 통한다는 것 (정규식, 삼항연산자 등)
-->
<FDL version="2.1">
  <Form id="Validation" width="800" height="600" titletext="입력값 검증 연습" onload="Validation_onload">
    <Layouts>
      <Layout height="600" width="800">
        <Static id="sta_name"  taborder="0" text="이름 *"     left="20"  top="30"  width="100" height="28"/>
        <Edit   id="edt_name"  taborder="1"                  left="130" top="30"  width="200" height="28"/>
        <Static id="sta_email" taborder="2" text="이메일 *"   left="20"  top="70"  width="100" height="28"/>
        <Edit   id="edt_email" taborder="3"                  left="130" top="70"  width="250" height="28"/>
        <Static id="sta_age"   taborder="4" text="나이"      left="20"  top="110" width="100" height="28"/>
        <Edit   id="edt_age"   taborder="5"                  left="130" top="110" width="100" height="28" inputtype="number"/>
        <Button id="btn_save"  taborder="6" text="저장"      left="130" top="160" width="100" height="32" onclick="btn_save_onclick"/>
      </Layout>
    </Layouts>
    <Script type="xscript5.1"><![CDATA[
/* 폼이 로드될 때 1회 실행 — 초기화 코드는 여기에 */
this.Validation_onload = function(obj:nexacro.Form, e:nexacro.LoadEventInfo)
{
	this.edt_name.setFocus();
	trace("폼 로드 완료 : " + this.name);
};

/* [저장] 버튼 — 검증 통과 시에만 저장 진행 */
this.btn_save_onclick = function(obj:nexacro.Button, e:nexacro.ClickEventInfo)
{
	if (!this.fn_validate()) return;   // 검증 실패 시 중단

	alert("저장되었습니다.\n이름: " + this.edt_name.value + "\n이메일: " + this.edt_email.value);
};

/* 검증 로직은 별도 함수로 분리 — 실무 관례 (fn_ 접두어)
   반환값: 통과 true / 실패 false                          */
this.fn_validate = function()
{
	// 1) 필수값 체크 — 빈 문자열, null 모두 걸러내기
	if (this.fn_isEmpty(this.edt_name.value)) {
		alert("이름을 입력하세요.");
		this.edt_name.setFocus();
		return false;
	}

	// 2) 이메일 형식 체크 — JavaScript 정규식 그대로 사용 가능
	var emailRegex = /^[\w.-]+@[\w.-]+\.\w{2,}$/;
	if (!emailRegex.test(this.edt_email.value)) {
		alert("이메일 형식이 올바르지 않습니다.");
		this.edt_email.setFocus();
		return false;
	}

	// 3) 선택값이지만 입력했다면 범위 체크
	var age = this.edt_age.value;
	if (!this.fn_isEmpty(age) && (Number(age) < 1 || Number(age) > 120)) {
		alert("나이는 1~120 사이로 입력하세요.");
		this.edt_age.setFocus();
		return false;
	}

	return true;
};

/* null / undefined / 공백 문자열 모두 '비어있음'으로 처리하는 유틸 */
this.fn_isEmpty = function(val)
{
	return (val == null || String(val).trim() == "");
};
]]></Script>
  </Form>
</FDL>
