<?xml version="1.0" encoding="utf-8"?>
<!--
  [3차시] 프로젝트 구조 — 좌측 메뉴 + 작업영역 레이아웃
  학습 포인트
   1. 실무에서는 MainFrame(.xadl) + FrameSet 으로 화면을 분할하지만,
      이 예제는 이해를 돕기 위해 하나의 Form 안에서 Div 로 같은 구조를 재현한다.
   2. Div 는 "화면 속 화면" — 다른 Form 을 불러올 수 있는 컨테이너 (set_url)
   3. anchor 개념: right/bottom 을 지정하면 창 크기에 따라 늘어난다.

  ※ 실제 FrameSet 구성 순서 (Studio 에서 시연)
     Project 탐색기 → App(.xadl) 더블클릭
     → MainFrame 추가 → HFrameSet 추가(LeftFrame: width 200 / WorkFrame)
     → 각 Frame 의 formurl 에 폼 연결
-->
<FDL version="2.1">
  <Form id="FrameLayout" width="1024" height="700" titletext="프레임 레이아웃 연습">
    <Layouts>
      <Layout height="700" width="1024">
        <!-- 상단 타이틀 영역: left 0 ~ right 0 으로 가로 전체 -->
        <Static id="sta_top" taborder="0" text="  사내 업무 시스템"
                left="0" top="0" right="0" height="50"
                style="background:#1f4e79; color:#ffffff; font:bold 14pt;"/>

        <!-- 좌측 메뉴 영역: top 50 ~ bottom 0 으로 세로 전체 -->
        <Div id="div_menu" taborder="1" left="0" top="50" width="200" bottom="0"
             style="background:#eff5f8; border:1px solid #cccccc;">
          <Layouts>
            <Layout>
              <Button id="btn_menu1" taborder="0" text="사원 관리" left="10" top="10" width="180" height="36" onclick="div_menu_btn_menu_onclick"/>
              <Button id="btn_menu2" taborder="1" text="부서 관리" left="10" top="52" width="180" height="36" onclick="div_menu_btn_menu_onclick"/>
              <Button id="btn_menu3" taborder="2" text="게시판"   left="10" top="94" width="180" height="36" onclick="div_menu_btn_menu_onclick"/>
            </Layout>
          </Layouts>
        </Div>

        <!-- 작업 영역: 나머지 공간 전부 (left 200 ~ right 0, top 50 ~ bottom 0) -->
        <Div id="div_work" taborder="2" left="200" top="50" right="0" bottom="0"
             style="background:#ffffff;"/>
      </Layout>
    </Layouts>
    <Script type="xscript5.1"><![CDATA[
/* 메뉴 버튼 공통 핸들러
   - 세 버튼이 같은 함수를 공유 → obj.id / obj.text 로 어떤 버튼인지 구분
   - div_work.set_url() 로 작업영역에 다른 폼을 로드한다. (화면 전환의 기본 원리) */
this.div_menu_btn_menu_onclick = function(obj:nexacro.Button, e:nexacro.ClickEventInfo)
{
	trace("선택된 메뉴 : " + obj.text);

	// 예: 사원 관리 클릭 시 2차시 Hello 폼을 작업영역에 로드
	if (obj.id == "btn_menu1") {
		this.div_work.set_url("Base::Hello.xfdl");   // Base 는 TypeDefinition 에 정의된 경로 별칭
	}
	else {
		alert(obj.text + " 화면은 아직 준비되지 않았습니다.");
	}
};
]]></Script>
  </Form>
</FDL>
